<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grid in HTml</title>
    <style>

        /* Grid Line & Grid Cell */
        /* Grid Track & Grid Area */
        .container{
            border: 2px solid black;
            border-radius: 10px;
            padding: 20px;
            display: grid;
            /* grid-template-columns: 200px 200px 200px; */
            /* grid-template-columns: repeat(3, 1fr); */
            /* grid-template-columns: 1fr 1fr 1fr; */
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));

            grid-gap: 50px;
        }

        .box{
            height: 50px;
            width: 50px;
            border: 2px solid blue;
            border-radius: 10px;
        }


        .box4{
            /* grid-row: 1/2;
            grid-row: 1/2; */
            /* grid-row-start: 1;
            grid-row-end: 2; */
            grid-column-start: 2;
            grid-column-end: 3;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="box box1">1</div>
        <div class="box">2</div>
        <div class="box">3</div>
        <div class="box box4">4</div>
        <div class="box">5</div>
    </div>
</body>
</html>